<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- CA1707: nazwy testów w konwencji Metoda_Scenariusz_Wynik celowo zawierają podkreślenia. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VisionSimulator.Core\VisionSimulator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Przykładowy profil projektu: test sprawdza, że kompiluje się bez błędów. -->
    <None Include="..\..\examples\profile-example.json" Link="examples\profile-example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
